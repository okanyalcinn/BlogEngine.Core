@using EntityLayer.Concrete
@model List<Blog>
@{
    ViewData["Title"] = "BlogListByWriter";
    Layout = "~/Views/Shared/WriterLayout.cshtml";
}

<script src="~/lib/jquery/dist/jquery.js"></script>

<script src="~/js/sweetalert2@11.js"></script>

<h1>Yazarın Blogları</h1>
<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Blog Başlığı</th>
        <th>Oluşturma Tarihi</th>
        <th>Kategori</th>
        <th>Durum</th>
        <th>Sil</th>
        <th>Düzenle</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <th>@item.BlogID</th>
            <td>@item.BlogTitle</td>
            <td>@(((DateTime)item.BlogCreateDate).ToString("dd-MMM-yyyy"))</td>
            <td>@item.Category.CategoryName</td>
            <td>@(item.BlogStatus == true ? "Aktif" : "Pasif")</td>
            <td><a href="#" onclick="return DeleteBlog(this, @item.BlogID)" class="btn btn-danger">Sil</a></td>
            <td><a href="/Blog/BlogEdit/@item.BlogID" class="btn btn-warning">Düzenle</a></td>
        </tr>
    }
</table>

<a href="/Blog/BlogAdd/" class="btn btn-primary">Yeni Blog Oluştur</a>

<script type="text/javascript">
    function DeleteBlog(element, id){
        //element.preventDefault(); // Direkt gitmesini engeller

        Swal.fire({
          title: "Silmek İstediğinize Emin Misiniz?",
          text: "Onaylarsanız blog silinecektir.",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#3085d6",
          cancelButtonColor: "#d33",
          confirmButtonText: "Evet Silmek İstiyorum",
          cancelButtonText: "Hayır"
        }).then((result) => {
          if (result.isConfirmed) {
            Swal.fire({
              title: "Silindi!",
              text: "Seçtiğiniz Blog Silindi.",
              icon: "success"
            }).then((result) =>{
                 window.location.href = "/Blog/BlogDelete/"+ id;
            })
          }
        });

        return false; // Linkin normal çalışmasını tamamen engeller
    }
</script>